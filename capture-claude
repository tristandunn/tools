#!/bin/bash

# Export the last Claude session to styled HTML.
#
# Dependencies: aha, kitty
# Requirements: Must have `allow_remote_control` enabled in Kitty.

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
TMP_FILE="/tmp/claude-session-$$.txt"
TMP_HTML="/tmp/claude-session-$$.html"
OUTPUT_FILE="$SCRIPT_DIR/claude-session-$(date +%Y%m%d-%H%M%S).html"

# Define custom CSS.
read -r -d '' CSS << 'EOF' || true
<style>
body {
  background: #FFFFFF;
  color: #000000;
  font-family: "Monaspace Neon Var", ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, "Liberation Mono", monospace;
  line-height: 1.2;
}
pre { margin: 0; }
.ef0, .black { color: #000000; }
.ef1, .red { color: #A00000; }
.ef2, .green { color: #00A000; }
.ef3, .olive, .yellow { color: #AA5500; }
.ef4, .navy, .blue { color: #0000AA; }
.ef5, .purple, .magenta { color: #AA00AA; }
.ef6, .teal, .cyan { color: #00AAAA; }
.ef7, .silver, .white { color: #AAAAAA; }
.ef8, .gray, .dimgray { color: #555555; }
.ef9 { color: #FF5555; }
.ef10 { color: #55FF55; }
.ef11 { color: #FFFF55; }
.ef12 { color: #5555FF; }
.ef13 { color: #FF55FF; }
.ef14 { color: #55FFFF; }
.ef15 { color: #FFFFFF; }
.eb0 { background-color: #000000; }
.eb1 { background-color: #FFDDDD; }
.eb2 { background-color: #DDFFDD; }
.eb3 { background-color: #FFFFDD; }
.eb4 { background-color: #DDDDFF; }
.eb5 { background-color: #FFDDFF; }
.eb6 { background-color: #DDFFFF; }
.eb7 { background-color: #EEEEEE; }
.eb8 { background-color: #555555; }
.eb9 { background-color: #FFDDDD; }
.eb10 { background-color: #DDFFDD; }
.eb11 { background-color: #FFFFDD; }
.eb12 { background-color: #DDDDFF; }
.eb13 { background-color: #FFDDFF; }
.eb14 { background-color: #DDFFFF; }
.eb15 { background-color: #FFFFFF; }
.bold { font-weight: bold; }
.italic { font-style: italic; }
.underline { text-decoration: underline; }
</style>
EOF

# Ensure the temporary files are cleaned up.
cleanup() {
  rm -f "$TMP_FILE" "$TMP_HTML"
}
trap cleanup EXIT

# Launch kitty window and capture the session.
WINDOW_ID=$(kitty @ launch --type=os-window --keep-focus --cwd="$(pwd)" --title "claude-export" -- claude --continue)
kitty @ resize-os-window --width 100 --unit cells --match "id:$WINDOW_ID"
sleep 2
kitty @ get-text --ansi --extent=all --match "id:$WINDOW_ID" > "$TMP_FILE"
kitty @ close-window --match "id:$WINDOW_ID"

# Strip the input prompt.
PROMPT_LINE=$(grep -n -- "-- INSERT --\|-- NORMAL --" "$TMP_FILE" | tail -1 | cut -d: -f1)
if [[ -n "$PROMPT_LINE" ]]; then
  head -n $((PROMPT_LINE - 5)) "$TMP_FILE" > "${TMP_FILE}.tmp"
  mv "${TMP_FILE}.tmp" "$TMP_FILE"
fi

# Convert the ANSI to HTML and inject the CSS.
aha --stylesheet < "$TMP_FILE" > "$TMP_HTML"
CSS_ONELINE=$(tr '\n' ' ' <<< "$CSS")

# Replace inline colors.
sed -e "s|</head>|${CSS_ONELINE}</head>|" \
    -e 's|color:#ffffff;background-color:#7a2936|color:#000;background-color:#FDD|g' \
    -e 's|color:#ffffff;background-color:#225c2b|color:#000;background-color:#DFD|g' \
    -e 's|color:#ffffff;background-color:#b3596b|color:#000;background-color:#FDD|g' \
    -e 's|color:#ffffff;background-color:#38a660|color:#000;background-color:#DFD|g' \
    -e 's|background-color:#7a2936|background-color:#FDD|g' \
    -e 's|background-color:#225c2b|background-color:#DFD|g' \
    -e 's|color:#ffffff;background-color:#373737|color:#000;background-color:#EEE|g' \
    "$TMP_HTML" > "$OUTPUT_FILE"

echo "Exported to: $OUTPUT_FILE"
